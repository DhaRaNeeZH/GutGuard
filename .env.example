# GutGuard Environment Configuration
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.

# Flask
FLASK_APP=run.py
FLASK_ENV=development
SECRET_KEY=change-this-to-a-long-random-secret-key

# Database
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=gutguard
DB_USER=root
DB_PASSWORD=your_database_password

# Admin
ADMIN_EMAIL=admin@gutguard.local
ADMIN_PASSWORD=change_admin_password

# Optional: email (not used in v1)
MAIL_SERVER=
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=
MAIL_PASSWORD=
